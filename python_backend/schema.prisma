generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──── Enums ────

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum Difficulty {
  easy
  medium
  hard
  expert
}

enum QuestionType {
  single_choice
  multiple_choice
  true_false
  short_answer
}

enum MasteryLevel {
  BEGINNER
  DEVELOPING
  GOOD
  STRONG
  MASTERED
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// ──── Auth & Users ────

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           Role      @default(STUDENT)
  avatarUrl      String?
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  studentProfile StudentProfile?
  refreshTokens  RefreshToken[]
  attempts       Attempt[]
  topicProgress  TopicProgress[]
  aiInteractions AIInteraction[]
  studySessions  StudySession[]
  achievements   UserAchievement[]
  auditLogs      AuditLog[]
  teacherOf      Subject[]        @relation("SubjectTeacher")
  groups         Group[]          @relation("GroupTeachers")
  lectures       Lecture[]
  sentMessages   Message[]        @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model StudentProfile {
  id          String  @id @default(uuid())
  userId      String  @unique
  groupId     String?
  studentCode String?
  xp          Int     @default(0)
  streak      Int     @default(0)
  bestStreak  Int     @default(0)
  lastStudyDate DateTime?
  dailyGoal   Int     @default(3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id])

  @@index([groupId])
}

model Group {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students      StudentProfile[]
  scheduleItems ScheduleItem[]
  teachers      User[]           @relation("GroupTeachers")
  lectures      Lecture[]
}

// ──── Academic ────

model Subject {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  teacherId   String?
  iconName    String?
  color       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher       User?          @relation("SubjectTeacher", fields: [teacherId], references: [id])
  topics        Topic[]
  tests         Test[]
  scheduleItems ScheduleItem[]
  lectures      Lecture[]

  @@index([teacherId])
}

model Topic {
  id          String   @id @default(uuid())
  name        String
  description String?
  subjectId   String
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject       Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions     TestQuestion[]
  topicProgress TopicProgress[]

  @@unique([subjectId, name])
  @@index([subjectId])
}

// ──── Schedule ────

model ScheduleItem {
  id            String   @id @default(uuid())
  externalId    String?
  subjectId     String
  groupId       String
  teacherName   String?
  room          String?
  dayOfWeek     Int
  startTime     String
  endTime       String
  weekType      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@index([groupId])
  @@index([dayOfWeek])
}

model ScheduleSnapshot {
  id           String   @id @default(uuid())
  providerMode String
  data         Json
  syncedAt     DateTime @default(now())
  success      Boolean  @default(true)
  errorMessage String?

  @@index([syncedAt])
}

// ──── Tests ────

model Test {
  id             String     @id @default(uuid())
  title          String
  subjectId      String
  topic          String?
  difficulty     Difficulty
  questionCount  Int
  questionTypes  String[]
  generatedBy    String     @default("gemini")
  createdAt      DateTime   @default(now())

  subject   Subject        @relation(fields: [subjectId], references: [id])
  questions TestQuestion[]
  attempts  Attempt[]

  @@index([subjectId])
}

model TestQuestion {
  id            String       @id @default(uuid())
  testId        String
  topicId       String?
  type          QuestionType
  question      String
  options       Json?
  correctAnswer Json
  explanation   String?
  difficulty    Difficulty
  orderIndex    Int          @default(0)
  createdAt     DateTime     @default(now())

  test    Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  topic   Topic?   @relation(fields: [topicId], references: [id])
  answers Answer[]

  @@index([testId])
}

model Attempt {
  id            String        @id @default(uuid())
  userId        String
  testId        String
  status        AttemptStatus @default(IN_PROGRESS)
  score         Float?
  percentage    Float?
  correctCount  Int?
  wrongCount    Int?
  skippedCount  Int?
  totalTime     Int?
  startedAt     DateTime      @default(now())
  completedAt   DateTime?
  savedProgress Json?
  aiAnalysis    Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  test    Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([userId])
  @@index([testId])
  @@index([userId, testId])
}

model Answer {
  id         String   @id @default(uuid())
  attemptId  String
  questionId String
  userAnswer Json?
  isCorrect  Boolean?
  timeSpent  Int?
  createdAt  DateTime @default(now())

  attempt  Attempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question TestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// ──── Progress ────

model TopicProgress {
  id              String       @id @default(uuid())
  userId          String
  topicId         String
  masteryScore    Float        @default(0)
  masteryLevel    MasteryLevel @default(BEGINNER)
  totalAttempts   Int          @default(0)
  correctAnswers  Int          @default(0)
  wrongAnswers    Int          @default(0)
  currentDifficulty Difficulty @default(easy)
  lastStudiedAt   DateTime?
  nextReviewAt    DateTime?
  reviewInterval  Int          @default(1)
  easeFactor      Float        @default(2.5)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
  @@index([nextReviewAt])
}

model StudySession {
  id          String   @id @default(uuid())
  userId      String
  subjectName String?
  topicName   String?
  activityType String
  duration    Int?
  xpEarned    Int      @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ──── AI ────

model AIInteraction {
  id           String   @id @default(uuid())
  userId       String
  type         String
  prompt       String
  response     String
  model        String?
  tokensUsed   Int?
  subjectName  String?
  topicName    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

// ──── Gamification ────

model Achievement {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String
  iconName    String
  xpReward    Int      @default(0)
  condition   Json
  createdAt   DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

// ──── Admin ────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ──── Lectures ────

model Lecture {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  groupId     String?
  subjectId   String
  teacherId   String
  fileUrl     String?
  fileName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group       Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([subjectId])
  @@index([teacherId])
}

// ──── Messenger ────

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String   @db.Text
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  
  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

