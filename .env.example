# ============================================
# NeoStudy — Environment Variables
# ============================================
# Copy this file to .env and fill in values. The only application backend is Python.

# ---------- Database ----------
DATABASE_URL=postgresql://aitutor:aitutor_secret@localhost:5433/aitutor?schema=public

# ---------- JWT ----------
JWT_SECRET=change-me-to-a-random-64-char-string
REFRESH_TOKEN_SECRET=change-me-to-another-random-64-char-string

# ---------- Server ----------
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SCHOOL_TIMEZONE=Asia/Almaty

# ---------- Google Gemini AI ----------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=90

# ---------- Classroom search (Java bridge -> C++) ----------
# Java schedule-server from team-ENERGO; never exposed to the frontend
ROOM_FINDER_JAVA_URL=http://127.0.0.1:3333
ROOM_FINDER_API_KEY=
ROOM_FINDER_TIMEOUT_SECONDS=12
ROOM_FINDER_MAX_CONCURRENCY=10
# Docker reaches Java on the host via host.docker.internal.
# Set this separately if Java runs on a remote machine:
# ROOM_FINDER_JAVA_URL_DOCKER=http://java-server:3333

# ---------- Docker PostgreSQL (production overrides) ----------
# POSTGRES_USER=aitutor
# POSTGRES_PASSWORD=replace-with-a-strong-password
# POSTGRES_DB=aitutor
# Compose keeps the existing postgres-data volume and supplies DATABASE_URL
# with the container hostname. Local Python uses DATABASE_URL above.

# ---------- Frontend ----------
VITE_API_URL=/api/v1
